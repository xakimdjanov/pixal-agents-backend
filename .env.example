# Copy to .env and fill in. Never commit .env. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PORT=3000

# Postgres password (compose builds DATABASE_URL=postgres://studio:<password>@postgres:5432/studio)
POSTGRES_PASSWORD=

# Signs login tokens (>= 32 chars). Changing it logs everyone out.
JWT_SECRET=

# Encrypts connector secrets at rest: 64 hex chars. BACK THIS UP.
CONNECTOR_KEY=

# Public host name (used by nginx server_name / certbot)
DOMAIN=localhost

# Only used when no founder exists. Change after first login.
DEFAULT_FOUNDER_PASSWORD=

# Agent data dir inside the container
DATA_DIR=/data
